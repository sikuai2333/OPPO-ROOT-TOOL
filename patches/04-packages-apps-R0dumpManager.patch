+  // process directory; keep reading those so old runs stay repairable.
+  fs::path jsonl = process / "records" / "records.jsonl";
+  std::ifstream input(jsonl, std::ios::binary);
+  if (!input) {
+    jsonl = process / "records.jsonl";
+    input.open(jsonl, std::ios::binary);
+    if (!input) {
+      return out;
+    }
