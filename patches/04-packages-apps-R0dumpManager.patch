+// sdcardfs gates /sdcard/Android/data/<pkg> on the caller's fsuid, and the
+// helper runs as root with CAP_DAC_OVERRIDE absent, so it cannot walk an app's
+// private directory as itself. Switch to the directory's owner for the duration
+// of the scan. Ownership here comes from the filesystem, not from the request,
+// so this cannot be steered to an arbitrary uid.
+class R0dumpUidScope {
+ public:
+  explicit R0dumpUidScope(uid_t uid) : target_uid_(uid) {
+    if (uid == 0 || uid == geteuid()) {
+      return;
+    }
+    const uid_t original = static_cast<uid_t>(setfsuid(uid));
+    if (static_cast<uid_t>(setfsuid(static_cast<uid_t>(-1))) != uid) {
+      setfsuid(original);
+      return;
+    }
+    active_ = true;
+    original_ = original;
+  }
+
+  ~R0dumpUidScope() { exit(); }
+
+  // Restore the helper's own fsuid early: staging and the final archive are
+  // written under Downloads, which the target app cannot create directories in.
+  void exit() {
+    if (active_) {
+      setfsuid(original_);
+      active_ = false;
+    }
+  }
+
+  // Re-enter the app's fsuid to read its run directory again.
+  void enter() {
+    if (active_ || target_uid_ == 0) {
+      return;
+    }
+    const uid_t original = static_cast<uid_t>(setfsuid(target_uid_));
+    if (static_cast<uid_t>(setfsuid(static_cast<uid_t>(-1))) != target_uid_) {
+      setfsuid(original);
+      return;
+    }
+    active_ = true;
+    original_ = original;
+  }
+
+  R0dumpUidScope(const R0dumpUidScope &) = delete;
+  R0dumpUidScope &operator=(const R0dumpUidScope &) = delete;
+
+ private:
+  bool active_ = false;
+  uid_t original_ = 0;
+  uid_t target_uid_ = 0;
+};
+
