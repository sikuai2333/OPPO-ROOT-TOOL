+// hima/OP4EA7 exposes /sdcard through sdcardfs rather than the FUSE daemon the
+// fusion design targets. sdcardfs synthesises ownership from its mount options
+// (fsuid/fsgid/mask), so fchown() and fchmod() on a directory below it fail with
+// EPERM no matter what the helper asks for. Ownership and mode can only be
+// verified in that case, not enforced.
+bool IsSdcardfsFd(int fd) {
+  struct statfs fs {};
+  if (fstatfs(fd, &fs) != 0)
+    return false;
+  return fs.f_type == 0x5DCA2DF5;  // SDCARDFS_SUPER_MAGIC
+}
