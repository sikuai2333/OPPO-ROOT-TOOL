+// Export runs for minutes on a packed target and the caller only sees a
+// blocking call. Publish coarse stage progress where the Manager (and adb) can
+// read it, so a long export is distinguishable from a hung one.
+void r0dump_WriteExportProgress(const char *stage, int percent) {
+  const char *path = "/storage/emulated/0/Downloads/r0dump-export-progress.json";
+  const int fd = open(path, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+  if (fd < 0) {
+    return;
+  }
+  char buffer[128];
+  const int n = snprintf(buffer, sizeof(buffer),
+                         "{\"stage\":\"%s\",\"percent\":%d,\"pid\":%d}\n", stage,
+                         percent, getpid());
+  if (n > 0) {
+    ssize_t ignored = write(fd, buffer, static_cast<size_t>(n));
+    (void)ignored;
+  }
+  close(fd);
+}
+
+// A packed target produces one record per capture observation -- tens of
+// thousands of ~1.2 KB JSON files. Copying them individually costs minutes on
+// sdcardfs and inflates the archive, while the consumer (SortedJsonRecords)
+// only reads them in name order anyway. Fold a records/ directory into a single
+// records.jsonl so the metadata survives verbatim at a fraction of the cost.
+bool r0dump_PackRecordsJsonl(const fs::path &records_dir,
+                             const fs::path &target_file) {
+  const int out =
+      open(target_file.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, kFileMode);
+  if (out < 0) {
+    return false;
+  }
+  std::vector<fs::path> paths;
+  std::error_code error;
+  for (const fs::directory_entry &entry : fs::directory_iterator(records_dir, error)) {
+    if (error) {
+      break;
+    }
+    if (entry.path().extension() == ".json" && entry.is_regular_file(error) &&
+        !entry.is_symlink(error)) {
+      paths.push_back(entry.path());
+    }
+  }
+  std::sort(paths.begin(), paths.end());
+
+  bool ok = true;
+  std::array<char, 64 * 1024> buffer{};
+  for (const fs::path &path : paths) {
+    const int in = open(path.c_str(), O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+    if (in < 0) {
+      ok = false;
+      break;
+    }
+    // JSON records are written without embedded newlines, so one file is one line.
+    ssize_t n = 0;
+    while ((n = TEMP_FAILURE_RETRY(read(in, buffer.data(), buffer.size()))) > 0) {
+      ssize_t written = 0;
+      while (written < n) {
+        const ssize_t w =
+            TEMP_FAILURE_RETRY(write(out, buffer.data() + written, static_cast<size_t>(n - written)));
+        if (w <= 0) {
+          ok = false;
+          break;
+        }
+        written += w;
+      }
+      if (!ok) {
+        break;
+      }
+    }
+    close(in);
+    if (!ok) {
+      break;
+    }
+    if (write(out, "\n", 1) != 1) {
+      ok = false;
+      break;
+    }
+  }
+  if (ok && fsync(out) != 0) {
+    ok = false;
+  }
+  close(out);
+  return ok;
+}
