+// Records are emitted as one jsonl per flush. Read them back as (name, json)
+// pairs, ordered by the record's own sequence so the caller sees the same order
+// the legacy per-file naming produced.
+struct r0dump_LoadedRecord {
+  std::string name;
+  Json::Value value;
+};
+
+std::vector<r0dump_LoadedRecord> r0dump_LoadRecordsJsonl(const fs::path &process) {
+  std::vector<r0dump_LoadedRecord> out;
+  const fs::path jsonl = process / "records" / "records.jsonl";
+  std::ifstream input(jsonl, std::ios::binary);
+  if (!input) {
+    return out;
+  }
+  Json::CharReaderBuilder builder;
+  std::string line;
+  while (std::getline(input, line)) {
+    if (line.empty()) {
+      continue;
+    }
+    Json::CharReaderBuilder reader_builder;
+    Json::Value value;
+    std::string errors;
+    std::unique_ptr<Json::CharReader> reader(reader_builder.newCharReader());
+    if (!reader->parse(line.data(), line.data() + line.size(), &value, &errors) ||
+        !value.isObject()) {
+      // A torn final line after a crash is expected; skip it like the legacy
+      // per-file reader skipped unparsable files.
+      continue;
+    }
+    const Json::Value &seq = value["seq"];
+    std::string name;
+    if (seq.isUInt64()) {
+      char buffer[32];
+      snprintf(buffer, sizeof(buffer), "%06llu.json",
+               static_cast<unsigned long long>(seq.asUInt64()));
+      name = buffer;
+    }
+    out.push_back({std::move(name), std::move(value)});
+  }
+  return out;
+}
