+// Export runs for minutes on a packed target and the caller only sees a
+// blocking call. Publish stage progress where the Manager (and adb) can read
+// it, so a long export is distinguishable from a hung one.
+//
+// done/total are the units the current stage actually moves through (files
+// copied, processes repaired, files archived); total 0 means the stage cannot
+// report a denominator. percent stays the coarse overall estimate.
+
+void r0dump_WriteExportProgress(const ExportProgressSink sink, void *context,
+                                const char *stage, int percent, uint64_t done,
+                                uint64_t total) {
+  if (sink != nullptr) {
+    sink(context, stage, percent, done, total);
+  }
+  const char *path = "/storage/emulated/0/Downloads/r0dump-export-progress.json";
+  const int fd = open(path, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+  if (fd < 0) {
+    return;
+  }
+  char buffer[192];
+  const int n = snprintf(buffer, sizeof(buffer),
+                         "{\"stage\":\"%s\",\"percent\":%d,\"done\":%llu,"
+                         "\"total\":%llu,\"pid\":%d}\n",
+                         stage, percent, static_cast<unsigned long long>(done),
+                         static_cast<unsigned long long>(total), getpid());
+  if (n > 0) {
+    ssize_t ignored = write(fd, buffer, static_cast<size_t>(n));
+    (void)ignored;
+  }
+  close(fd);
+}
