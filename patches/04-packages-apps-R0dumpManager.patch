+// sdcardfs creates entries owned by the calling fsuid, so the helper has to
+// impersonate the target app for mkdirat() as well as for openat().
+int MkdiratAsUid(int parent_fd, const char *name, mode_t mode,
+                 uid_t access_uid) {
+  const uid_t original_fsuid = static_cast<uid_t>(setfsuid(access_uid));
+  if (static_cast<uid_t>(setfsuid(static_cast<uid_t>(-1))) != access_uid) {
+    setfsuid(original_fsuid);
+    errno = EACCES;
+    return -1;
+  }
+  const int result = mkdirat(parent_fd, name, mode);
+  const int saved_errno = errno;
+  setfsuid(original_fsuid);
+  errno = saved_errno;
+  return result;
+}
