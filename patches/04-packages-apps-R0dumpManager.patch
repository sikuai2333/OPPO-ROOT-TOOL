+// std::filesystem::copy_file goes through copy_file_range()/reflink first, and
+// sdcardfs answers that with EPERM. Stream the bytes instead so the copy works on
+// every mount this device has.
+bool r0dump_CopyStream(const fs::path &source, const fs::path &destination,
+                       mode_t mode) {
+  // Read as the app (sdcardfs only lets its owner in), then write the staging
+  // copy as ourselves: FUSE refuses a plain app uid at the top of Downloads.
+  const uid_t read_fsuid = static_cast<uid_t>(setfsuid(static_cast<uid_t>(-1)));
+  const int in = open(source.c_str(), O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+  if (in < 0) {
+    return false;
+  }
+  setfsuid(geteuid());
+  const int out =
+      open(destination.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, mode);
+  if (out < 0) {
+    close(in);
+    setfsuid(read_fsuid);
+    return false;
+  }
+
+  std::array<char, 256 * 1024> buffer{};
+  bool ok = true;
+  while (ok) {
+    const ssize_t read_bytes = TEMP_FAILURE_RETRY(read(in, buffer.data(), buffer.size()));
+    if (read_bytes < 0) {
+      ok = false;
+      break;
+    }
+    if (read_bytes == 0) {
+      break;
+    }
+    ssize_t written = 0;
+    while (written < read_bytes) {
+      const ssize_t n = TEMP_FAILURE_RETRY(
+          write(out, buffer.data() + written, static_cast<size_t>(read_bytes - written)));
+      if (n <= 0) {
+        ok = false;
+        break;
+      }
+      written += n;
+    }
+  }
+
+  if (ok && fsync(out) != 0) {
+    ok = false;
+  }
+  close(out);
+  close(in);
+  setfsuid(geteuid());
+  return ok;
+}
