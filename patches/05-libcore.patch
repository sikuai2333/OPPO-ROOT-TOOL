+ *      http://www.apache.org/licenses/LICENSE-2.0
+ */
+
+package dalvik.system;
+
+/**
+ * r0dump-fusion: Java bridge to the ART-integrated capture pipeline.
+ *
+ * <p>{@code art/runtime/native/dalvik_system_r0dump_Runtime.cc} registers every {@code native}
+ * method declared here. This class marshals arguments, keeps the armed capture-point mask
+ * visible to the Java-layer routing hooks in {@link BaseDexClassLoader}, and exposes the
+ * dex-cookie walk used by {@code android.app.r0dump_ClassLoaderWalk}.
+ *
+ * @hide
+ */
+public final class r0dump_Runtime {
+    private r0dump_Runtime() {}
+
+    private static java.lang.reflect.Method sGetDexCookies;
+
+    /** BaseDexClassLoader.r0dump_GetDexCookies is package-private; bind it once. */
+    private static Object[] r0dump_getDexCookies(ClassLoader loader) {
+        java.lang.reflect.Method m = sGetDexCookies;
+        if (m == null) {
+            try {
+                m = BaseDexClassLoader.class.getDeclaredMethod(
+                        "r0dump_GetDexCookies", ClassLoader.class);
+                m.setAccessible(true);
+                sGetDexCookies = m;
+            } catch (ReflectiveOperationException | RuntimeException e) {
+                return new Object[0];
+            }
+        }
+        try {
+            final Object r = m.invoke(null, loader);
+            return r instanceof Object[] ? (Object[]) r : new Object[0];
+        } catch (ReflectiveOperationException | RuntimeException e) {
+            return new Object[0];
+        }
+    }
+
+
+    /** Non-zero when at least one capture point is armed; volatile so hook sites see updates. */
+    private static volatile long r0dump_capturePointMask;
+
+    /**
+     * Configure the capture session.
+     *
+     * <p>The mask reaches {@code r0dump_capturePointMask} only after the native side accepts
+     * the configuration, so routing hooks can never fire against a rejected session.
+     */
+    public static boolean r0dump_configure(
+            int schema,
+            boolean enabled,
+            String runId,
+            String targetPackage,
+            String targetProcess,
+            String processName,
+            String outputParent,
+            int preparedDirectoryFd,
+            long capturePointMask,
+            long maxRecords,
+            long maxArtifacts,
+            long maxTotalBytes,
+            long maxDexBytes,
+            long bufferPoolBytes,
+            long maxCodeItemBytes,
+            long maxFrozenGenerations,
+            long flushIdleMs,
+            boolean manifestEnabled,
+            boolean manifestIncludeSplits,
+            long manifestMaxComponents,
+            long manifestMaxSplits,
+            long manifestMaxEventsPerSource,
+            long manifestMaxTotalEvents,
+            long manifestMaxXmlDepth,
+            long manifestMaxAttributeLength,
+            boolean walkEnabled,
+            int walkStart,
+            int walkMode,
+            String walkNamespacePrefix,
+            long walkDelayMs,
+            long walkMaxClasses,
+            long walkMaxMethods,
+            boolean forceInvokeEnabled,
+            String forceClass,
+            String forceMethod,
+            String forceMethodDescriptor,
+            long forceMaxCalls) {
+        final boolean accepted = r0dump_configureNative(
+                schema, enabled, runId, targetPackage, targetProcess, processName, outputParent,
+                preparedDirectoryFd, capturePointMask, maxRecords, maxArtifacts, maxTotalBytes,
+                maxDexBytes, bufferPoolBytes, maxCodeItemBytes, maxFrozenGenerations, flushIdleMs,
+                manifestEnabled, manifestIncludeSplits, manifestMaxComponents, manifestMaxSplits,
+                manifestMaxEventsPerSource, manifestMaxTotalEvents, manifestMaxXmlDepth,
+                manifestMaxAttributeLength, walkEnabled, walkStart, walkMode,
+                walkNamespacePrefix, walkDelayMs, walkMaxClasses, walkMaxMethods,
+                forceInvokeEnabled, forceClass, forceMethod, forceMethodDescriptor, forceMaxCalls);
+        r0dump_capturePointMask = enabled && accepted ? capturePointMask : 0L;
+        return accepted;
+    }
+
+    private static native boolean r0dump_configureNative(
+            int schema,
+            boolean enabled,
+            String runId,
+            String targetPackage,
+            String targetProcess,
+            String processName,
+            String outputParent,
+            int preparedDirectoryFd,
+            long capturePointMask,
+            long maxRecords,
+            long maxArtifacts,
+            long maxTotalBytes,
+            long maxDexBytes,
+            long bufferPoolBytes,
+            long maxCodeItemBytes,
+            long maxFrozenGenerations,
+            long flushIdleMs,
+            boolean manifestEnabled,
+            boolean manifestIncludeSplits,
+            long manifestMaxComponents,
+            long manifestMaxSplits,
+            long manifestMaxEventsPerSource,
+            long manifestMaxTotalEvents,
+            long manifestMaxXmlDepth,
+            long manifestMaxAttributeLength,
+            boolean walkEnabled,
+            int walkStart,
+            int walkMode,
+            String walkNamespacePrefix,
+            long walkDelayMs,
+            long walkMaxClasses,
+            long walkMaxMethods,
+            boolean forceInvokeEnabled,
+            String forceClass,
+            String forceMethod,
+            String forceMethodDescriptor,
+            long forceMaxCalls);
+
+    /** True when the given capture point (an {@code r0dump_Point} ordinal) is armed. */
+    static boolean r0dump_IsCapturePointActive(int point) {
+        final long mask = r0dump_capturePointMask;
+        return mask != 0L && point >= 0 && point < Long.SIZE && (mask & (1L << point)) != 0L;
+    }
+
+    /**
+     * Route a freshly created class loader through the capture pipeline.
+     *
+     * <p>A masked-out point costs one volatile read, which matters because this runs from
+     * {@code BaseDexClassLoader}'s constructors.
+     */
+    static void r0dump_CaptureRouteLoader(ClassLoader loader, int point) {
+        if (loader == null || !r0dump_IsCapturePointActive(point)) {
+            return;
+        }
+        if (!(loader instanceof BaseDexClassLoader)) {
+            return;
+        }
+        final Object[] cookies = r0dump_getDexCookies(loader);
+        for (Object cookie : cookies) {
+            r0dump_CaptureRouteCookie(cookie, point, null);
+        }
+    }
+
+    static void r0dump_CaptureRouteCookie(Object cookie, int point, String className) {
+        if (cookie == null || !r0dump_IsCapturePointActive(point)) {
+            return;
+        }
+        r0dump_CaptureRouteCookieNative(cookie, point, className);
+    }
+
+    private static native void r0dump_CaptureRouteCookieNative(
+            Object cookie, int point, String className);
+
+    /** Every class loader ART currently tracks. */
+    public static native ClassLoader[] r0dump_GetRegisteredClassLoaders();
+
+    public static native String[] r0dump_GetLoadedClassNames(ClassLoader loader);
+
+    public static native String[] r0dump_GetCookieClassNames(Object cookie);
+
+    public static native String[] r0dump_GetDexCacheClassNames(
+            ClassLoader loader, String namespacePrefix);
+
+    public static native Class<?> r0dump_FindLoadedClass(ClassLoader loader, String className);
+
+    public static native void r0dump_CaptureCookie(Object cookie, int sourceId);
+
+    public static native void r0dump_CaptureExecutable(
+            java.lang.reflect.Executable executable,
+            Object cookie,
+            String className,
+            int sourceId);
+
+    public static native boolean r0dump_ForceInvoke(
+            java.lang.reflect.Executable executable, Object receiver, String className);
+
+    public static native boolean r0dump_PublishManifestSnapshot(
+            String status,
+            String packageName,
+            String[] classNames,
+            String[] seedKinds,
+            int[] sourceOrdinals,
+            String[] sourceKinds,
+            String[] sourceStatuses,
+            int[] sourceEventCounts,
+            String[] sourceLimitHits,
+            int sourceCount,
+            int parsedSourceCount,
+            int rejectedSourceCount,
+            int xmlEventCount,
+            String limitHit);
+
+    public static native boolean r0dump_CompleteWalk(boolean bootstrapCompleted);
+
+    public static native boolean r0dump_ServiceFlush();
+
+    
+    /** Runtime dex cookies reachable from a class loader, without walking its parents. */
+    static Object[] r0dump_GetDexCookies(ClassLoader loader) {
+        return r0dump_getDexCookies(loader);
+    }
+}
