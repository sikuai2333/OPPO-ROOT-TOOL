+        final java.util.ArrayList<Object> cookies = new java.util.ArrayList<>();
+        for (int index = start; index < dexElements.length; ++index) {
+            final Element element = dexElements[index];
+            if (element == null) {
+                continue;
+            }
+            final Object cookie = element.r0dump_GetDexCookie();
+            if (cookie != null) {
+                cookies.add(cookie);
+            }
+        }
+        return cookies.toArray();
+    }
