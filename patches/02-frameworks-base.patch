+package android.app;
+
+import java.lang.reflect.Method;
+
+/**
+ * r0dump: access to {@code dalvik.system.r0dump_Runtime}.
+ *
+ * <p>The class is declared with {@code @SystemApi(client = MODULE_LIBRARIES)} and
+ * registered in {@code libcore/api/module-lib-current.txt}, but frameworks/base still
+ * cannot import it at compile time: the {@code core_platform} stubs framework links
+ * against are produced from the prebuilt {@code prebuilts/module_sdk/art} snapshot,
+ * not regenerated from this tree.
+ *
+ * <p>Reflection is therefore used at compile time only. At runtime the class resolves
+ * to the real implementation on the boot classpath, and the module-lib API entry makes
+ * hiddenapi treat these members as supported rather than blocked.
+ */
+final class r0dump_Bridge {
+    private static final String CLASS = "dalvik.system.r0dump_Runtime";
+
+    private static volatile Method sConfigure;
+    private static volatile Method sGetRegisteredClassLoaders;
+    private static volatile Method sGetLoadedClassNames;
+    private static volatile Method sGetCookieClassNames;
+    private static volatile Method sGetDexCacheClassNames;
+    private static volatile Method sFindLoadedClass;
+    private static volatile Method sCaptureCookie;
+    private static volatile Method sCaptureExecutable;
+    private static volatile Method sForceInvoke;
+    private static volatile Method sPublishManifestSnapshot;
+    private static volatile Method sCompleteWalk;
+    private static volatile Method sServiceFlush;
+    private static volatile Method sGetDexCookies;
+    private static volatile boolean sProbed;
+
+    private r0dump_Bridge() {}
+
+    private static void probe() {
+        if (sProbed) {
+            return;
+        }
+        synchronized (r0dump_Bridge.class) {
+            if (sProbed) {
+                return;
+            }
+            try {
+                final Class<?> c = Class.forName(CLASS);
+                sConfigure = c.getDeclaredMethod("r0dump_configure",
+                        int.class, boolean.class, String.class, String.class,
+                        String.class, String.class, String.class, int.class,
+                        long.class, long.class, long.class, long.class, long.class,
+                        long.class, long.class, long.class, long.class, boolean.class,
+                        boolean.class, long.class, long.class, long.class, long.class,
+                        long.class, long.class, boolean.class, int.class, int.class,
+                        String.class, long.class, long.class, long.class, boolean.class,
+                        String.class, String.class, String.class, long.class);
+                sGetRegisteredClassLoaders =
+                        c.getDeclaredMethod("r0dump_GetRegisteredClassLoaders");
+                sGetLoadedClassNames =
+                        c.getDeclaredMethod("r0dump_GetLoadedClassNames", ClassLoader.class);
+                sGetCookieClassNames =
+                        c.getDeclaredMethod("r0dump_GetCookieClassNames", Object.class);
+                sGetDexCacheClassNames = c.getDeclaredMethod(
+                        "r0dump_GetDexCacheClassNames", ClassLoader.class, String.class);
+                sFindLoadedClass = c.getDeclaredMethod(
+                        "r0dump_FindLoadedClass", ClassLoader.class, String.class);
+                sCaptureCookie =
+                        c.getDeclaredMethod("r0dump_CaptureCookie", Object.class, int.class);
+                sCaptureExecutable = c.getDeclaredMethod("r0dump_CaptureExecutable",
+                        java.lang.reflect.Executable.class, Object.class,
+                        String.class, int.class);
+                sForceInvoke = c.getDeclaredMethod("r0dump_ForceInvoke",
+                        java.lang.reflect.Executable.class, Object.class, String.class);
+                sPublishManifestSnapshot = c.getDeclaredMethod(
+                        "r0dump_PublishManifestSnapshot",
+                        String.class, String.class, String[].class, String[].class,
+                        int[].class, String[].class, String[].class, int[].class,
+                        String[].class, int.class, int.class, int.class, int.class,
+                        String.class);
+                sCompleteWalk = c.getDeclaredMethod("r0dump_CompleteWalk", boolean.class);
+                sServiceFlush = c.getDeclaredMethod("r0dump_ServiceFlush");
+                sGetDexCookies = Class.forName("dalvik.system.BaseDexClassLoader")
+                        .getDeclaredMethod("r0dump_GetDexCookies", ClassLoader.class);
+            } catch (ReflectiveOperationException | RuntimeException e) {
+                // Leave the failing method null; callers degrade gracefully.
+            } finally {
+                sProbed = true;
+            }
+        }
+    }
+
+    private static Object invoke(Method m, Object... args) {
+        if (m == null) {
+            return null;
+        }
+        try {
+            m.setAccessible(true);
+            return m.invoke(null, args);
+        } catch (ReflectiveOperationException | RuntimeException e) {
+            return null;
+        }
+    }
+
+    static boolean configure(
+            int schema, boolean enabled, String runId, String targetPackage,
+            String targetProcess, String processName, String outputParent,
+            int preparedDirectoryFd, long capturePointMask, long maxRecords,
+            long maxArtifacts, long maxTotalBytes, long maxDexBytes, long bufferPoolBytes,
+            long maxCodeItemBytes, long maxFrozenGenerations, long flushIdleMs,
+            boolean manifestEnabled, boolean manifestIncludeSplits, long manifestMaxComponents,
+            long manifestMaxSplits, long manifestMaxEventsPerSource,
+            long manifestMaxTotalEvents, long manifestMaxXmlDepth,
+            long manifestMaxAttributeLength, boolean walkEnabled, int walkStart,
+            int walkMode, String walkNamespacePrefix, long walkDelayMs, long walkMaxClasses,
+            long walkMaxMethods, boolean forceInvokeEnabled, String forceClass,
+            String forceMethod, String forceMethodDescriptor, long forceMaxCalls) {
+        probe();
+        final Object r = invoke(sConfigure, schema, enabled, runId, targetPackage,
+                targetProcess, processName, outputParent, preparedDirectoryFd,
+                capturePointMask, maxRecords, maxArtifacts, maxTotalBytes, maxDexBytes,
+                bufferPoolBytes, maxCodeItemBytes, maxFrozenGenerations, flushIdleMs,
+                manifestEnabled, manifestIncludeSplits, manifestMaxComponents,
+                manifestMaxSplits, manifestMaxEventsPerSource, manifestMaxTotalEvents,
+                manifestMaxXmlDepth, manifestMaxAttributeLength, walkEnabled, walkStart,
+                walkMode, walkNamespacePrefix, walkDelayMs, walkMaxClasses, walkMaxMethods,
+                forceInvokeEnabled, forceClass, forceMethod, forceMethodDescriptor,
+                forceMaxCalls);
+        return r instanceof Boolean && (Boolean) r;
+    }
+
+    static ClassLoader[] getRegisteredClassLoaders() {
+        probe();
+        final Object r = invoke(sGetRegisteredClassLoaders);
+        return r instanceof ClassLoader[] ? (ClassLoader[]) r : new ClassLoader[0];
+    }
+
+    static String[] getLoadedClassNames(ClassLoader loader) {
+        probe();
+        final Object r = invoke(sGetLoadedClassNames, loader);
+        return r instanceof String[] ? (String[]) r : new String[0];
+    }
+
+    static String[] getCookieClassNames(Object cookie) {
+        probe();
+        final Object r = invoke(sGetCookieClassNames, cookie);
+        return r instanceof String[] ? (String[]) r : new String[0];
+    }
+
+    static String[] getDexCacheClassNames(ClassLoader loader, String namespacePrefix) {
+        probe();
+        final Object r = invoke(sGetDexCacheClassNames, loader, namespacePrefix);
+        return r instanceof String[] ? (String[]) r : new String[0];
+    }
+
+    static Class<?> findLoadedClass(ClassLoader loader, String className) {
+        probe();
+        final Object r = invoke(sFindLoadedClass, loader, className);
+        return r instanceof Class ? (Class<?>) r : null;
+    }
+
+    static void captureCookie(Object cookie, int sourceId) {
+        probe();
+        invoke(sCaptureCookie, cookie, sourceId);
+    }
+
+    static void captureExecutable(java.lang.reflect.Executable executable,
+                                  Object cookie, String className, int sourceId) {
+        probe();
+        invoke(sCaptureExecutable, executable, cookie, className, sourceId);
+    }
+
+    static boolean forceInvoke(java.lang.reflect.Executable executable,
+                               Object receiver, String className) {
+        probe();
+        final Object r = invoke(sForceInvoke, executable, receiver, className);
+        return r instanceof Boolean && (Boolean) r;
+    }
+
+    static boolean publishManifestSnapshot(String status, String packageName,
+                                           String[] classNames, String[] seedKinds,
+                                           int[] sourceOrdinals, String[] sourceKinds,
+                                           String[] sourceStatuses, int[] sourceEventCounts,
+                                           String[] sourceLimitHits, int sourceCount,
+                                           int parsedSourceCount, int rejectedSourceCount,
+                                           int xmlEventCount, String limitHit) {
+        probe();
+        final Object r = invoke(sPublishManifestSnapshot, status, packageName, classNames,
+                seedKinds, sourceOrdinals, sourceKinds, sourceStatuses, sourceEventCounts,
+                sourceLimitHits, sourceCount, parsedSourceCount, rejectedSourceCount,
+                xmlEventCount, limitHit);
+        return r instanceof Boolean && (Boolean) r;
+    }
+
+    static boolean completeWalk(boolean bootstrapCompleted) {
+        probe();
+        final Object r = invoke(sCompleteWalk, bootstrapCompleted);
+        return r instanceof Boolean && (Boolean) r;
+    }
+
+    static boolean serviceFlush() {
+        probe();
+        final Object r = invoke(sServiceFlush);
+        return r instanceof Boolean && (Boolean) r;
+    }
+
+    static Object[] getDexCookies(ClassLoader loader) {
+        probe();
+        final Object r = invoke(sGetDexCookies, loader);
+        return r instanceof Object[] ? (Object[]) r : new Object[0];
+    }
+}
